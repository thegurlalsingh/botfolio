generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  candidate
  hr
}

enum Step {
  info
  mcq
  video
  coding
  completed
}

model ExperienceTimeline {
  id       String  @id @default(uuid())
  title    String?
  company  String?
  duration String?
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EducationTimeLine {
  id          String  @id @default(uuid())
  college     String?
  degree_name String?
  from_to     String?
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  password            String
  role                Role                 @default(candidate)
  refreshToken        String?
  refreshTokenExpires DateTime?
  jobDescriptions     JobDescription[]
  phone               String?
  location            String?
  resumeUrl           String?
  currentStep         Step?                @default(info)
  skills              String[]             @default([])
  designation         String?
  experienceYear      String?
  experienceTimeline  ExperienceTimeline[]
  educationTimeLine   EducationTimeLine[]
  createdAt           DateTime             @default(now())
  mcqAttempts         McqAttempt[]
  mcqScore            Float?
  videoAttempts       VideoInterview[]
  videoScore          Float?
  codingAttempts      CodingAttempt[]
  codingScore         Float?
}

model McqQuestion {
  id            String     @id @default(uuid())
  attemptId     String

  question     String
  options      String[]
  correct      String
  explanation  String?

  topic        String?
  difficulty   String?
  competency   String?

  candidateAnswer String?
  isCorrect       Boolean?

  createdAt DateTime @default(now())

  attempt McqAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model McqAttempt {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions McqQuestion[]

  score     Float         @default(0)
  completed Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
}

