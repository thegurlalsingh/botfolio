model VideoInterview {
  id          String               @id @default(cuid())
  userId      String
  currentStep Int                  @default(1)
  totalSteps  Int                  @default(5)
  completed   Boolean              @default(false)
  finalScore  Float?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id])
  steps       VideoInterviewStep[]

  @@index([userId])
}

model VideoInterviewStep {
  id          String         @id @default(cuid())
  interviewId String
  stepNumber  Int
  question    String
  videoUrl    String?
  audioUrl    String?
  transcript  String?
  score       Float?
  relevance   Float?
  clarity     Float?
  confidence  Float?
  feedback    String?
  completed   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  interview   VideoInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, stepNumber])
  @@index([interviewId])
}

model CodingAttempt {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  question  String
  testCases Json
  code      String?
  language  String?
  score     Float?
  feedback  String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}
